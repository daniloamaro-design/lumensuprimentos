# ─────────────────────────────────────────────────────────────────
# tools/migracao/.env  — SEGREDOS DA MIGRAÇÃO (NUNCA versionar)
# Copie este arquivo para  tools/migracao/.env  e preencha os valores.
# O .env real está no .gitignore — não vai para o GitHub.
# ─────────────────────────────────────────────────────────────────

# Project URL (público)
SUPABASE_URL=https://saalwqfjhnvleltqfftr.supabase.co

# anon / publishable key (pública por design)
SUPABASE_ANON_KEY=sb_publishable_N23E2SHI9SBehB8-f-OF3g_W_8T2JEk

# service_role / secret key — Supabase → Settings → API → "service_role" (secret)
# NUNCA vai para o site nem para o git. Só usada nos scripts locais de migração.
SUPABASE_SERVICE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# String de conexão do banco — Supabase → Settings → Database →
# "Connection string" → aba "Session pooler" (compatível com IPv4).
# Troque [YOUR-PASSWORD] pela senha do banco definida na criação do projeto.
DATABASE_URL=postgresql://postgres.saalwqfjhnvleltqfftr:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Caminho para a chave de conta de serviço do Firebase (JSON) — usada pelo export
# (10-export.mjs) e pela migração de usuários. NÃO expira, ao contrário do gcloud.
# Baixe em: Firebase Console → Configurações do projeto (engrenagem) → Contas de
# serviço → "Gerar nova chave privada". Salve o JSON num local seguro FORA do repo
# (ex.: C:\Users\compu\lumen-firebase-sa.json) e aponte aqui. NUNCA versionar.
FIREBASE_SA_PATH=C:\Users\compu\lumen-firebase-sa.json
