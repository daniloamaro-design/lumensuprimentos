{
  "version": 2,
  "functions": {
    "api/gemini.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/gemini", "destination": "/api/gemini.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
