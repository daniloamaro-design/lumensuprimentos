{
  "version": 2,
  "build": {
    "env": {
      "GEMINI_API_KEY": "@gemini_api_key",
      "EMAILJS_SERVICE_ID": "@emailjs_service_id",
      "EMAILJS_TEMPLATE_ID": "@emailjs_template_id",
      "EMAILJS_PUBLIC_KEY": "@emailjs_public_key"
    }
  },
  "routes": [
    { "src": "/config.js", "dest": "/config.js" },
    { "src": "/lumen-auth.js", "dest": "/lumen-auth.js" },
    { "src": "/lumen-ia.js", "dest": "/lumen-ia.js" },
    { "src": "/lumen-rbac.js", "dest": "/lumen-rbac.js" },
    { "src": "/lumen-bi.js", "dest": "/lumen-bi.js" },
    { "src": "/(.*\\.js)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}